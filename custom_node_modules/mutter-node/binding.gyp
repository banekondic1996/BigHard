{
  "targets": [
    {
      "target_name": "mutter_wrap",
      "sources": [ "mutter_wrap.cc" ],
      "include_dirs": [
        "<!@(sh -c 'pkg-config --cflags-only-I libmutter-17 2>/dev/null || pkg-config --cflags-only-I libmutter-16 2>/dev/null || pkg-config --cflags-only-I libmutter-15 2>/dev/null' | sed s/-I//g)",
        "<!@(pkg-config --cflags-only-I glib-2.0 | sed s/-I//g)"
      ],
      "libraries": [
        "<!@(sh -c 'pkg-config --libs libmutter-17 2>/dev/null || pkg-config --libs libmutter-16 2>/dev/null || pkg-config --libs libmutter-15 2>/dev/null')",
        "<!@(pkg-config --libs glib-2.0)"
      ],
      "cflags": [
        "-std=c++17",
        "<!@(sh -c 'pkg-config --cflags libmutter-17 2>/dev/null || pkg-config --cflags libmutter-16 2>/dev/null || pkg-config --cflags libmutter-15 2>/dev/null')",
        "<!@(pkg-config --cflags glib-2.0)"
      ],
      "cflags_cc": [
        "-std=c++17",
        "-fexceptions"
      ]
    }
  ]
}
